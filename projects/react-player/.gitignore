# Dependencies and build output
node_modules/
dist/
.vite/
.svelte-kit/
*.tsbuildinfo

# Local environment
.env
.env.*
!.env.example
*.local

# Logs and editor files
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Raw TTS takes (large WAV); the mp3, the alignment JSON, and the texts sent to the voice stay committed
audio/build/**/*.wav

# Local run artifacts: the ffmpeg join list holds machine paths, the log is per run, and archived takes stay local
audio/build/**/concat.txt
audio/build/**/run.log
audio/build/**/archive/

# Retired audio of chapters that were rewritten or archived in react-10 (texts, takes, mp3, timing); kept on this machine only
archive/
